{
  "manifest_version": 3,
  "name": "Markbase",
  "version": "1.0.0",
  "description": "Save and browse your Markbase bookmarks from any page.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Markbase",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>"]
}
